#include <iostream>
#include <vector>
using namespace std;

int main() {
    vector<string> tasks;
    int c, n;
    string task;

    do {
        cout << "\n1.Add 2.Remove 3.Display 4.Exit: ";
        cin >> c;
        cin.ignore();

        if (c == 1) {
            getline(cin, task);
            tasks.push_back(task);
        }
        if (c == 2) {
            cin >> n;
            if (n > 0 && n <= tasks.size())
                tasks.erase(tasks.begin() + n - 1);
        }
        if (c == 3)
            for (int i = 0; i < tasks.size(); i++)
                cout << i + 1 << ". " << tasks[i] << endl;

    } while (c != 4);
}
